---
interface Props {
  background: string;
  color: string;
}

const { background, color } = Astro.props;
---

<div
  class="color-swatch"
  style={`background:${background}; color:${color};`}
>
  <slot />
</div>

<style>
  .color-swatch {
    width: 100%;
    height: 200px;
    display: grid;
    place-items: center;
  }
</style>
